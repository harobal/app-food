# Optional inquiry delivery adapter. Without it, the API returns an honest
# unavailable response and directs users to direct email.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=

# Deployment URLs used by metadata and cross-site links.
NEXT_PUBLIC_PRIMARY_SITE_URL=https://harobalventures.com
NEXT_PUBLIC_STONES_SITE_URL=https://stones.harobalventures.com
NEXT_PUBLIC_FOODS_SITE_URL=https://foods.harobalventures.com

# Optional verified public channels. Leave blank to hide phone/WhatsApp.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
