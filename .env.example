# ------------------------------------------------------------------------------
# Harobal Foods Environment Variables
# ------------------------------------------------------------------------------

# Zoho Mail SMTP Configuration (Production / Staging)
# Set these in your hosting dashboard or in .env.local
ZOHO_MAIL_USER="foods@harobal.com"
ZOHO_MAIL_PASSWORD="your-zoho-app-password-here"
ZOHO_SMTP_HOST="smtpp.zoho.in"
ZOHO_SMTP_PORT="465"
ZOHO_SMTP_SECURE="true"
ZOHO_MAIL_FROM="Harobal Foods Trade Desk <foods@harobal.com>"
FOODS_NOTIFICATION_EMAIL="foods@harobal.com"

# API Security Secret for Anti-Tamper Client Challenge Tokens
INQUIRY_SIGNING_SECRET="harobal-foods-secure-intake-key-v1"

# Webhook Fallback (Optional)
# INQUIRY_WEBHOOK_URL="https://api.example.com/webhooks/foods-inquiry"
# INQUIRY_WEBHOOK_TOKEN="your-secret-token"

# Public Brand Channels
NEXT_PUBLIC_PRIMARY_SITE_URL="https://harobal.com"
NEXT_PUBLIC_FOODS_SITE_URL="https://foods.harobal.com"
NEXT_PUBLIC_STONES_SITE_URL="https://stones.harobal.com"
NEXT_PUBLIC_ENERGY_SITE_URL="https://energy.harobal.com"
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""
